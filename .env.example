# Server-only credentials. Never put these in NEXT_PUBLIC variables or source control.
WORKATO_SYNC_TOKEN=
# Exact NetSuite account/environment identifier; sandbox and production must differ.
NETSUITE_ACCOUNT_ID=
# Optional separate storage directory (single-process local deployment only).
# WAREHOUSE_DATA_DIR=

# Outbound Slack notifications via the dedicated Workato API recipe.
# Server-only; admin must publish the recipe as an authenticated POST endpoint.
WORKATO_SLACK_ALERT_URL=
WORKATO_SLACK_ALERT_TOKEN=
